# Set these only in your local environment or Vercel Environment Variables.
# Use the provider's pooled PostgreSQL URL, including its TLS settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
ADMIN_EMAIL=you@example.com
# Generate interactively: npm run admin:password
ADMIN_PASSWORD_HASH=scrypt:SALT:HASH

# Per-section drafting (server-only; configure in Vercel)
AI_GATEWAY_API_KEY=
# Use an available text model supporting structured output: provider/model
AI_DRAFT_MODEL=
